{
  "manifest_version": 3,
  "name": "Fill with AI",
  "version": "2.1.0",
  "description": "Fills job applications from your Fill with AI profile, with AI for open questions. You review and submit.",
  "action": {
    "default_title": "Fill this page with AI (Alt+Shift+F)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon128.png"
  }
}
